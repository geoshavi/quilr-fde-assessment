# Copy to .env and fill in as needed. All values below are placeholders only.
# Vars marked "(not read by code)" are documentation of intent only -- setting
# them has no runtime effect. Kept for reviewer clarity rather than deleted.

# Task 2 — MCP Security Gateway
# Bearer token -> role mapping is hardcoded in task2_mcp_gateway/auth.py for
# this assessment (no real identity provider); these two are illustrative only.
# (not read by code)
TASK2_ADMIN_TOKEN=placeholder-admin-token
TASK2_VIEWER_TOKEN=placeholder-viewer-token
# Actually used by task2_mcp_gateway/proxy.py -- downstream MCP server URL.
TASK2_DOWNSTREAM_URL=http://localhost:8100

# Task 3 — Streaming Guardrail
# Actually used by task3_stream_guardrail/app.py -- mock LLM upstream URL.
TASK3_UPSTREAM_URL=http://localhost:8100/generate
# (not read by code) -- the port is chosen when launching uvicorn, e.g.
# `uvicorn task3_stream_guardrail.app:app --port 8200`, not via this variable.
TASK3_PORT=8200

# Task 4 — Rate Limiter + Fallback Router
# Actually used by task4_model_router/rate_limiter.py.
TASK4_RATE_LIMIT_DB_PATH=./task4_model_router/rate_limit.db
TASK4_RATE_LIMIT_WINDOW_SECONDS=60
TASK4_RATE_LIMIT_MAX_TOKENS=50000
# Actually used by task4_model_router/router.py.
TASK4_PRIMARY_TIMEOUT_MS=3000
# (not read by code) -- primary/secondary providers are injected as Python
# callables (see task4_model_router/providers_mock.py), not configured by URL.
TASK4_PRIMARY_PROVIDER_URL=http://localhost:8300
TASK4_SECONDARY_PROVIDER_URL=http://localhost:8301
